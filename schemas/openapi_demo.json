{
  "openapi": "3.1.0",
  "info": {
    "title": "QualityRelay17 research API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/demo": {
      "get": {
        "summary": "Demo",
        "operationId": "demo_demo_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/simulation/compare": {
      "post": {
        "summary": "Simulation",
        "operationId": "simulation_simulation_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/research/claims": {
      "get": {
        "summary": "Claims",
        "operationId": "claims_research_claims_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/simulation/factory-line": {
      "get": {
        "summary": "Factory Line",
        "operationId": "factory_line_simulation_factory_line_get",
        "parameters": [
          {
            "name": "n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "N"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 2026,
              "title": "Seed"
            }
          },
          {
            "name": "lines",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "title": "Lines"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/integrations/nvidia": {
      "get": {
        "summary": "Nvidia Status",
        "operationId": "nvidia_status_integrations_nvidia_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SimRequest": {
        "properties": {
          "n": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 1.0,
            "title": "N",
            "default": 1000
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 2026
          },
          "process_shift_mm": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Process Shift Mm",
            "default": 0.1
          },
          "camera_noise": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Camera Noise",
            "default": 0.04
          },
          "network_outage": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Network Outage",
            "default": 0.05
          }
        },
        "type": "object",
        "title": "SimRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}