{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualityrelay/sim/simulation_response/18.1",
  "title": "QualityRelay simulation run record (SIM-07 -> API-01)",
  "description": "One digital-factory run as produced by qualityrelay17.sim.experiment.api_record. Proposed by Bakdaulet; adilnurgg owns the final API schema. source_tier is always SIMULATED and must never be promoted.",
  "type": "object",
  "required": ["source_tier", "seed", "model_version", "run_id", "assumption_set", "scenario", "policy", "pairing",
               "shipped", "shipped_good", "escaped", "good_per_hour", "conservation_ok", "truth_sha256"],
  "properties": {
    "source_tier": {"const": "SIMULATED"},
    "seed": {"type": "integer"},
    "model_version": {"type": "string"},
    "run_id": {"type": "string"},
    "assumption_set": {"type": "string"},
    "scenario": {"type": "string"},
    "policy": {"enum": ["rules", "bayes", "hold_all"]},
    "pairing": {"enum": ["fifo", "optimized"]},
    "makespan_s": {"type": "number", "minimum": 0},
    "shipped": {"type": "integer", "minimum": 0},
    "shipped_good": {"type": "integer", "minimum": 0},
    "escaped": {"type": "integer", "minimum": 0},
    "good_per_hour": {"type": "number", "minimum": 0},
    "mean_cycle_s": {"type": "number"},
    "p95_cycle_s": {"type": "number"},
    "part_holds": {"type": "integer"},
    "pair_holds": {"type": "integer"},
    "holds_stale_evidence": {"type": "integer"},
    "scrapped_parts": {"type": "integer"},
    "hold_inventory_part_hours": {"type": "number"},
    "downtime_s": {"type": "number"},
    "conservation_ok": {"type": "boolean"},
    "truth_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calibration_id": {"type": "string"},
    "cad_revision": {"type": "string"},
    "cost_per_good_unit": {"type": ["number", "null"]},
    "profit_per_hour": {"type": "number"}
  },
  "additionalProperties": false
}
