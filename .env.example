# Never commit real API keys. For live LLM access, use a hackathon-authorized account.
NEBIUS_API_KEY=
NEBIUS_MODEL=
ALLOW_LIVE_NEBIUS_REVIEW=NO
# Distinct per-station HMAC signing keys (>= 32 chars each), read by qualityrelay17/api.py.
# Generate into a git-ignored .env with: python scripts/provision_station_keys.py
# Blank = that station is unprovisioned and its hardware endpoint answers 503. Dev samples MUST NOT be deployed.
# Where POST /hardware/* evidence is persisted. Blank = in-memory SQLite (lost on restart).
# Point at a file (e.g. examples/results/hardware_ledger.sqlite) for any run you want to keep.
HARDWARE_LEDGER_PATH=
SLOT_STATION_KEY=
TAB_STATION_KEY=
SORTER_STATION_KEY=
PHONE_STATION_KEY=
PI_STATION_KEY=
CAD_STATION_KEY=
