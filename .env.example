# Never commit real API keys. For live LLM access, use a hackathon-authorized account.
NEBIUS_API_KEY=
# Model id from GET /v1/models under the team's key; must support tool calling (task board candidate: zai-org/GLM-5.3-Flash).
NEBIUS_MODEL=
# Optional, from the Nebius price page. Blank = tokens logged, no USD computed, USD cap not enforced.
NEBIUS_PRICE_INPUT_PER_MTOK=
NEBIUS_PRICE_OUTPUT_PER_MTOK=
ALLOW_LIVE_NEBIUS_REVIEW=NO
# Distinct per-station HMAC signing keys (>= 32 chars each), read by qualityrelay17/api.py.
# Generate into a git-ignored .env with: python scripts/provision_station_keys.py
# Blank = that station is unprovisioned and its hardware endpoint answers 503. Dev samples MUST NOT be deployed.
# Where POST /hardware/* evidence is persisted. Blank = in-memory SQLite (lost on restart).
# Point at a file (e.g. examples/results/hardware_ledger.sqlite) for any run you want to keep.
HARDWARE_LEDGER_PATH=
SLOT_STATION_KEY=
TAB_STATION_KEY=
SORTER_STATION_KEY=
PHONE_STATION_KEY=
PI_STATION_KEY=
CAD_STATION_KEY=
# Per-device keys (BACK-01). Each one is flashed onto that station's ESP32 and authenticates
# the X-Station-* request envelope. Distinct from the *_STATION_KEY above on purpose.
# Read one out for flashing: python scripts/provision_station_keys.py --show-device-key sorter
SLOT_DEVICE_KEY=
TAB_DEVICE_KEY=
SORTER_DEVICE_KEY=
PHONE_DEVICE_KEY=
PI_DEVICE_KEY=
CAD_DEVICE_KEY=
# Accept envelopes whose device timestamp is within this many seconds of server time.
STATION_AUTH_TTL_S=60

# ---- Human operators (BACK-02/04): staging/approving routes, arming, E-stop reset, ground-truth checks.
# One bearer token per person, >= 32 chars: python scripts/provision_station_keys.py --operators alice bob
# No operators provisioned = those routes answer 503. Software E-stop and disarm need no token.
OPERATOR_ALICE_TOKEN=
# ---- Sorter command path (BACK-04). OFF by default: /hardware/sorter/next-command then only ever answers HOLD.
# Even when 1, an operator must POST /actuation/arm, and the device must report its E-stop loop and guard closed.
ACTUATION_HARDWARE_ENABLED=0
# Approved route not moved/acknowledged within this many seconds -> EXPIRED (needs re-approval).
ACTUATION_STAGE_TTL_S=600
# Dispatched command without an independent bin-sensor ACK within this many seconds -> FAULTED + disarm.
ACTUATION_ACK_TIMEOUT_S=30
# A dispatched command is void after this many seconds (expires_at); the device must stay at HOLD.
ACTUATION_COMMAND_TTL_S=10

# ---- LLM planners for the collaboration roles (AGENT-04). Configuration only; never commit keys.
# OpenAI: model name must come from your own account's model list and must support tool calling.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional. GPT-5.x reasoning models need 'none' to use function tools on /v1/chat/completions. Blank = not sent.
OPENAI_REASONING_EFFORT=
# Optional: proxy / compatible endpoint. Leave blank for api.openai.com.
OPENAI_BASE_URL=
# Optional: USD per 1M tokens from your provider's price page. Blank = tokens logged, cost "unpriced".
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
# Hard per-run caps shared by every LLM planner. The run stops requesting and decides on what it has.
LLM_MAX_CALLS_PER_RUN=12
LLM_MAX_TOKENS_PER_RUN=60000
LLM_MAX_USD_PER_RUN=0.50
# Set to 1 only when you deliberately want pytest to make the paid live smoke test call.
RUN_LIVE_LLM=0
